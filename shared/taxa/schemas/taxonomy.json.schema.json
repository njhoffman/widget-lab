{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parent_id",
          "classification_assertions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stx:"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^stx:"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification_assertions": {
            "type": "array"
          },
          "extinct": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
