{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "media"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stx:"
          },
          "type": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
